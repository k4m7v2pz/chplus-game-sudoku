// 数独
定义(空类型) 主函数() {
    控制台输出("═══ 数独 ═══");
    控制台输出("题目(0 表示空):");
    控制台输出("5 3 0 | 0 7 0 | 0 0 0");
    控制台输出("6 0 0 | 1 9 5 | 0 0 0");
    控制台输出("0 9 8 | 0 0 0 | 0 6 0");
    控制台输出("8 0 0 | 0 6 0 | 0 0 3");
    控制台输出("4 0 0 | 8 0 3 | 0 0 1");
    控制台输出("7 0 0 | 0 2 0 | 0 0 6");
    控制台输出("0 6 0 | 0 0 0 | 2 8 0");
    控制台输出("0 0 0 | 4 1 9 | 0 0 5");
    控制台输出("0 0 0 | 0 8 0 | 0 7 9");
    控制台输出("第一空(行1列3)应填什么?");
    定义(整型) ans;
    控制台输入(ans);
    如果 (ans == 4) {
        控制台输出("正确!");
    }否则{
        控制台输出("不对,应是 4");
    }
}
